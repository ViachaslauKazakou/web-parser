POSTGRES_DB=forumscope
POSTGRES_USER=forumscope
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DATA_DIR=./data/postgres
APP_PORT=8040
PARSER_ALLOWED_HOSTS=searchengines.guru
MAX_PARSER_PAGES=20
MAX_PARSER_PAGE_CHARS=2000000
PARSER_TOTAL_TIMEOUT_SECONDS=180
MAX_UPLOAD_BYTES=5242880
MAX_REQUEST_BODY_BYTES=10485760

# Optional OpenAI-compatible chat completions; deterministic scoring works without these.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
